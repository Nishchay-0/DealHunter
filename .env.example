# DealHunter Environment Variables Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to version control.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database URL (PostgreSQL in production; SQLite or PostgreSQL in development)
# Examples:
#   PostgreSQL: postgresql+asyncpg://dealhunter:password@localhost:5432/dealhunter
#   SQLite (local test): sqlite+aiosqlite:///dealhunter.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dealhunter

# Application Environment (development | staging | production)
ENVIRONMENT=development

# FastAPI Server Port
PORT=8000
